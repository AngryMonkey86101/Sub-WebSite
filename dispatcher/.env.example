# Диспетчер в РФ: скопируйте в .env и заполните (README.md, «Установка»)

# Имя портала в DuckDNS — тот же адрес, что открывается в браузере, без https://
PORTAL_HOST=

# Бот — тот же, что у портала: токен от @BotFather и id вашего чата
# (админка портала → раздел «Telegram» → «id чата»). Диспетчер сообщения только отправляет.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пользователь на сервере VPN, которым забирается бэкап
SSH_USER=deploy
# SSH_PORT=22

# Zomro — логин и пароль кабинета: диспетчер заказывает и удаляет через API серверы VPN (только свои,
# с именем family-vpn-…). Пароль храните как пароль: им можно тратить деньги с баланса.
ZOMRO_USER=
ZOMRO_PASSWORD=
# ZOMRO_PRICELIST=7920   тариф (7920 — Blitz Intel | NL-3, 0,31 EUR в день)
# ZOMRO_DATACENTER=17    дата-центр (17 — Нидерланды, 19 — Германия, 21 — США, 25 — Польша)
# ZOMRO_OS=2140c514-fa2b-4b38-90e4-f9ff394245d1   образ ОС (Ubuntu 24.04)
# ZOMRO_BUILD_MIN=90     сколько ждать, пока Zomro соберёт сервер (активен и с IP), минут
# ZOMRO_SSH_MIN=20       и потом — пока на нём откроется SSH, минут

# Необязательно:
# CHECK_INTERVAL_SEC=60        проверка сервера из РФ — раз в столько секунд
# ALERT_AFTER_MIN=15           сообщение, если сервер недоступен столько минут подряд
# BACKUP_INTERVAL_MIN=60       бэкап с сервера — раз в столько минут
# BACKUP_KEEP=48               сколько последних бэкапов хранить
# BACKUP_ALERT_AFTER_HOURS=3   сообщение, если свежего бэкапа нет столько часов (а сервер доступен)
# REFERENCE_URLS=https://ya.ru/,https://vk.com/   свой интернет: если ни один не открывается — сервер не судим
# NODE_IMAGE=mirror.gcr.io/library/node:22.23.4-alpine3.24   если Docker Hub недоступен
