# Скопируйте в .env рядом с docker-compose.yml и заполните. Файл .env — только на сервере
# (права 600) и в зашифрованном бэкапе. В репозиторий его не добавлять.

# Имена DuckDNS (без https://). Два разных случайных имени, оба указывают на IP сервера.
# PORTAL_HOST — сайт портала, для него Caddy получит сертификат.
# VPN_HOST — адрес сервера в ключах VPN; сертификата для него нет.
PORTAL_HOST=m2pr7x.duckdns.org
VPN_HOST=k4tq9v.duckdns.org

# Протоколы для выдачи, первый — основной. Пока только AmneziaWG.
# Xray отложен: когда понадобится — PROTOCOLS=amneziawg3,xray (см. README, «Позже: Xray»).
PROTOCOLS=amneziawg3
DEFAULT_DEVICE_LIMIT=4

# Ключ доступа портала к amnezia-api, не короче 32 символов: openssl rand -hex 32
AMNEZIA_API_KEY=
# Версия образа amnezia-api, обновлять только прочитав изменения
AMNEZIA_API_VERSION=2.0.0
# Постоянный идентификатор сервера: cat /proc/sys/kernel/random/uuid
SERVER_ID=
# Группа docker.sock: stat -c '%g' /var/run/docker.sock
DOCKER_GID=
# Версия Docker API на сервере: docker version --format '{{.Server.APIVersion}}'
DOCKER_API_VERSION=

# Ключ шифрования выданных ключей VPN в базе портала: openssl rand -base64 32
# Потеряете его — сохранённые ключи нельзя будет показать снова (VPN при этом продолжит работать).
KEY_ENCRYPTION_KEY=

# Бот админа от @BotFather (README, шаг 6). Пусто — уведомления только в журнале контейнера.
# Чат подключается из админки; TELEGRAM_CHAT_ID — только чтобы задать чат вручную (например, группу).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сторож IP (README, шаг 7): токен с duckdns.org. При смене IP портал сам обновит записи
# VPN_HOST и PORTAL_HOST. Токен управляет всеми именами аккаунта — храните как пароль.
DUCKDNS_TOKEN=

# Бэкап (README, шаг 10): открытый ключ age админа, строка age1…. Раз в сутки бот присылает
# зашифрованный бэкап в Telegram. Закрытый ключ — только у админа, на сервер его не кладите.
BACKUP_AGE_RECIPIENT=

# Диспетчер в РФ (dispatcher/README.md): его открытый ключ age — бэкап шифруется и им, и ключом
# админа; его открытый SSH-ключ — им он забирает бэкап (только бэкап: install-dispatcher-key.sh).
# Оба выдаёт диспетчер командой keys. Пусто — диспетчера нет.
DISPATCHER_AGE_RECIPIENT=
DISPATCHER_SSH_KEY=

# Оплата через ЮKassa (README, «Продажа доступа через бота»): номер магазина и секретный ключ
# (ЮKassa → Интеграция → Ключи API). Пусто — заказы подтверждает админ вручную.
# Ключ test_… — тестовый магазин, live_… — боевой. Секретный ключ храните как пароль.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Необязательно: своя страница загрузки приложения (по умолчанию https://amnezia.org/ru/downloads)
# APP_DOWNLOAD_URL=
